{
  "name": "Basket — Colour",
  "dataColors": ["#4f63c8", "#1fb8a6", "#f6a623", "#ef6b4e", "#8b7ff5", "#3fb8e8", "#f2c94c", "#9bb0c9"],
  "background": "#FFFFFF",
  "foreground": "#1f2937",
  "tableAccent": "#4f63c8",
  "good": "#1fb8a6",
  "neutral": "#f6a623",
  "bad": "#ef6b4e",
  "maximum": "#ef6b4e",
  "center": "#f6a623",
  "minimum": "#1fb8a6",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#1f2937" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1f2937" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#8a94a6" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#1f2937" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": false, "radius": 6 }],
        "dropShadow": [{ "show": true, "color": { "solid": { "color": "#d9deea" } }, "position": "Outer", "preset": "BottomRight" }],
        "visualHeader": [{ "show": false }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1f2937" } }, "fontSize": 12, "fontFamily": "Segoe UI Semibold" }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#8a94a6" } }, "fontSize": 9, "gridlineShow": false, "showAxisTitle": false }],
        "valueAxis": [{ "labelColor": { "solid": { "color": "#8a94a6" } }, "fontSize": 9, "gridlineColor": { "solid": { "color": "#eceff5" } }, "showAxisTitle": false }],
        "legend": [{ "show": true, "position": "Top", "fontSize": 9, "labelColor": { "solid": { "color": "#8a94a6" } } }],
        "dataPoint": [{ "fill": { "solid": { "color": "#4f63c8" } } }],
        "labels": [{ "color": { "solid": { "color": "#8a94a6" } }, "fontSize": 9 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#f3f5f9" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#e9edf4" } } }]
      }
    },
    "card": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }],
        "labels": [{ "color": { "solid": { "color": "#1f2937" } }, "fontSize": 26, "fontFamily": "Segoe UI Semibold" }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#8a94a6" } }, "fontSize": 9 }]
      }
    },
    "slicer": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }],
        "header": [{ "show": true, "fontColor": { "solid": { "color": "#8a94a6" } }, "fontSize": 9 }],
        "items": [{ "fontColor": { "solid": { "color": "#1f2937" } }, "background": { "solid": { "color": "#FFFFFF" } }, "fontSize": 10 }],
        "selection": [{ "selectAllCheckboxEnabled": false, "singleSelect": true }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{ "gridVertical": false, "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#eceff5" } }, "rowPadding": 6, "textSize": 10 }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#8a94a6" } }, "backColor": { "solid": { "color": "#FFFFFF" } }, "fontSize": 9, "bold": true }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#1f2937" } }, "backColorPrimary": { "solid": { "color": "#FFFFFF" } }, "backColorSecondary": { "solid": { "color": "#f7f9fc" } } }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 2, "lineStyle": "solid", "showMarker": false }],
        "dataPoint": [{ "fill": { "solid": { "color": "#4f63c8" } } }]
      }
    },
    "areaChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 2, "lineStyle": "solid", "showMarker": false }],
        "dataPoint": [{ "fill": { "solid": { "color": "#4f63c8" } } }]
      }
    },
    "barChart": {
      "*": {
        "dataPoint": [{ "fill": { "solid": { "color": "#4f63c8" } } }]
      }
    },
    "clusteredBarChart": {
      "*": {
        "dataPoint": [{ "fill": { "solid": { "color": "#4f63c8" } }, "showAllDataPoints": true }]
      }
    }
  }
}
